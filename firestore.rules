rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function existingData() {
      return resource.data;
    }

    function incomingData() {
      return request.resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bungtemin@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 1. User Profiles
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['displayName', 'email', 'role', 'createdAt']) &&
               data.keys().size() == 4 &&
               data.displayName is string && data.displayName.size() <= 100 &&
               data.email == request.auth.token.email &&
               data.role in ['admin', 'cashier'] &&
               data.createdAt == request.time;
      }

      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incomingData()) && incomingData().role == 'cashier';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incomingData().diff(existingData()).affectedKeys().hasOnly(['displayName'])) ||
        (isAdmin() && incomingData().diff(existingData()).affectedKeys().hasOnly(['role']))
      );
    }

    // 2. Products
    match /products/{productId} {
      function isValidProduct(data) {
        return data.keys().hasAll(['name', 'price', 'stock', 'category', 'imageUrl', 'createdAt', 'updatedAt']) &&
               data.keys().size() == 7 &&
               data.name is string && data.name.size() <= 200 &&
               data.price is number && data.price >= 0 &&
               data.stock is int &&
               data.category is string &&
               data.imageUrl is string &&
               data.createdAt is timestamp &&
               data.updatedAt is timestamp;
      }

      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incomingData()) && incomingData().createdAt == request.time;
      allow update: if isAdmin() && isValidProduct(incomingData()) && incomingData().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // 3. Transactions
    match /transactions/{transactionId} {
      function isValidTransaction(data) {
        return data.keys().hasAll(['items', 'totalAmount', 'paymentMethod', 'status', 'userId', 'createdAt']) &&
               data.keys().size() == 6 &&
               data.items is list && data.items.size() > 0 &&
               data.totalAmount is number && data.totalAmount >= 0 &&
               data.paymentMethod in ['cash', 'qris', 'card'] &&
               data.status in ['paid', 'refunded'] &&
               data.userId == request.auth.uid &&
               data.createdAt == request.time;
      }

      allow read: if isSignedIn() && (existingData().userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(transactionId) && isValidTransaction(incomingData());
      allow update: if isAdmin() && incomingData().diff(existingData()).affectedKeys().hasOnly(['status']);
    }
  }
}
